[Unit]
Description=Local Connect status dashboard (static, loopback only)
After=network.target

[Service]
WorkingDirectory=%h/Desktop/local-connect-status
ExecStartPre=/usr/bin/mkdir -p site
ExecStart=/usr/bin/env python3 -m http.server 8790 --directory site --bind 127.0.0.1
Restart=on-failure

[Install]
WantedBy=default.target
